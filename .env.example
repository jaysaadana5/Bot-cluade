# Polymarket API
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_SECRET=your_polymarket_secret
POLYMARKET_PASSPHRASE=your_polymarket_passphrase
POLYMARKET_FUNDER=your_wallet_address

# X (Twitter) API - for sentiment analysis
X_BEARER_TOKEN=your_x_bearer_token
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret

# Trading Configuration
BOT_INTERVAL_SECONDS=300
MAX_POSITION_SIZE=100
RISK_PER_TRADE=0.02
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10

# Database
DATABASE_URL=sqlite:///./data/trading_bot.db

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_TRADINGVIEW_SYMBOL=BTCUSD
