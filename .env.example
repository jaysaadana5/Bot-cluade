# Polymarket API
# Your Polygon wallet private key (for order signing)
POLYMARKET_PRIVATE_KEY=your_polygon_wallet_private_key
POLYMARKET_FUNDER=your_wallet_address
# API credentials (auto-generated from private key via dashboard or scripts/generate_api_keys.py)
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# X (Twitter) API - for sentiment analysis
X_BEARER_TOKEN=your_x_bearer_token
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret

# Trading Mode: "paper" or "live"
TRADING_MODE=paper
PAPER_STARTING_BALANCE=10000

# Trading Configuration
BOT_INTERVAL_SECONDS=300
MAX_POSITION_SIZE=100
RISK_PER_TRADE=0.02
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10

# Database
DATABASE_URL=sqlite:///./data/trading_bot.db

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_TRADINGVIEW_SYMBOL=BTCUSD
